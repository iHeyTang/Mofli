{
  "name": "@mofli/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node bin/mofli.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@mofli/core": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.34",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.0",
    "@mofli/grove": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "mofli": "./bin/mofli.mjs"
  },
  "files": [
    "bin",
    "*.html",
    "*.js",
    "*.ts",
    "*.css",
    "dist",
    "README.md",
    "cat-studies",
    "src",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./project-types.d.ts",
      "default": "./project.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Mofli Studio: standalone React pet creator app and CLI"
}
