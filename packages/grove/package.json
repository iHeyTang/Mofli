{
  "name": "@mofli/grove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accessories": {
      "types": "./dist/accessories/index.d.ts",
      "import": "./dist/accessories/index.js"
    },
    "./rigs/bloub": {
      "types": "./dist/rigs/bloub/index.d.ts",
      "import": "./dist/rigs/bloub/index.js"
    },
    "./rigs/mew": {
      "types": "./dist/rigs/mew/index.d.ts",
      "import": "./dist/rigs/mew/index.js"
    },
    "./skins/bloub": {
      "types": "./dist/skins/bloub/index.d.ts",
      "import": "./dist/skins/bloub/index.js"
    },
    "./skins/cat-ink": {
      "types": "./dist/skins/cat-ink/index.d.ts",
      "import": "./dist/skins/cat-ink/index.js"
    },
    "./skins/cat-patches": {
      "types": "./dist/skins/cat-patches/index.d.ts",
      "import": "./dist/skins/cat-patches/index.js"
    },
    "./skins/mofli-bean": {
      "types": "./dist/skins/mofli-bean/index.d.ts",
      "import": "./dist/skins/mofli-bean/index.js"
    },
    "./skins/mofli-dough": {
      "types": "./dist/skins/mofli-dough/index.d.ts",
      "import": "./dist/skins/mofli-dough/index.js"
    },
    "./skins/mofli-stone": {
      "types": "./dist/skins/mofli-stone/index.d.ts",
      "import": "./dist/skins/mofli-stone/index.js"
    },
    "./rigs/cat-head": {
      "types": "./dist/rigs/mew/index.d.ts",
      "import": "./dist/rigs/mew/index.js"
    },
    "./accessories/*.json": "./dist/accessories/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "mofli dev",
    "check": "npm run build && mofli check",
    "export:pet": "mofli export"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@mofli/studio": "^0.1.0"
  },
  "dependencies": {
    "@mofli/core": "^0.1.0"
  }
}
