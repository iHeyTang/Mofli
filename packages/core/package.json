{
  "name": "@mofli/core",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./radial": {
      "types": "./dist/radial.d.ts",
      "import": "./dist/radial.js"
    },
    "./spherical-face": {
      "types": "./dist/spherical-face.d.ts",
      "import": "./dist/spherical-face.js"
    },
    "./scene3d": {
      "types": "./dist/scene3d.d.ts",
      "import": "./dist/scene3d.js"
    },
    "./spatial-browser": {
      "types": "./dist/spatial-browser.d.ts",
      "import": "./dist/spatial-browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build 1>&2",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "description": "Framework-independent SVG pet engine, resource protocols and browser integration",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHeyTang/Mofli.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/iHeyTang/Mofli#readme",
  "bugs": {
    "url": "https://github.com/iHeyTang/Mofli/issues"
  }
}
