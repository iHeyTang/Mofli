{
  "name": "@mofli/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./radial": {
      "types": "./dist/radial.d.ts",
      "import": "./dist/radial.js"
    },
    "./spherical-face": {
      "types": "./dist/spherical-face.d.ts",
      "import": "./dist/spherical-face.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
